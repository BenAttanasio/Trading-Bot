# ─── Alpaca ──────────────────────────────────────────────────────────────
ALPACA_API_KEY=your_alpaca_key
ALPACA_SECRET_KEY=your_alpaca_secret
# Paper by default. For a live endpoint you must ALSO set LIVE_TRADING=I_UNDERSTAND
# or the bot refuses to start.
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
LIVE_TRADING=

# ─── Anthropic ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key
# Model per tier. Defaults keep Opus out entirely (Sonnet 5 ranks/decides/reviews,
# Haiku 4.5 triages). Set AI_DEEP_MODEL=claude-opus-5 to opt back in for the deep tier.
AI_BUDGET_MODEL=claude-haiku-4-5
AI_FAST_MODEL=claude-sonnet-5
AI_DEEP_MODEL=claude-sonnet-5

# ─── MongoDB ─────────────────────────────────────────────────────────────
MONGODB_URI=your_mongodb_connection_string
MONGODB_DB_NAME=trading_bot

# ─── Server ──────────────────────────────────────────────────────────────
PORT=3001
# Absolute path to the built dashboard; defaults to ../dashboard/dist relative to dist/
DASHBOARD_DIST=
# Serve DB-derived fake data instead of live Alpaca data (dashboard demos)
DEMO_MODE=0

# ─── Trading rules (defaults shown; the playbook may tighten these at runtime) ──
MAX_POSITION_SIZE_DOLLARS=50
MAX_PORTFOLIO_EXPOSURE=500
MAX_DAILY_TRADES=10
MAX_DAILY_LOSS_PERCENT=3
COOLDOWN_MINUTES=120
REVENGE_TRADE_COOLDOWN_HOURS=24
MAX_HOLD_DAYS_BEFORE_REVIEW=30
# Morning cycle: how many top-conviction buys, and below what invested % to run in
# "initial deployment" mode (conviction bar 5 instead of 6)
MORNING_MAX_BUYS=8
INITIAL_DEPLOYMENT_BELOW_PERCENT=10
SELL_COOLDOWN_MINUTES=60
POSITION_REVIEW_COOLDOWN_MINUTES=90
# Volatility-scaled sizing: % of equity at risk between entry and the stop.
# notional = risk / stop distance, then capped by MAX_POSITION_SIZE_DOLLARS and the hard 25%-of-equity ceiling.
RISK_PER_TRADE_PERCENT=0.5
# Shorts (whole shares, easy-to-borrow only). 0 = long only.
ENABLE_SHORTS=0
MORNING_MAX_SHORTS=2
# Morning universe: watchlist + Alpaca movers/most-actives screener, capped and price-filtered
UNIVERSE_SCREENER=1
UNIVERSE_MAX_CANDIDATES=30
UNIVERSE_MIN_PRICE=5
# Code-enforced stop / target / time-stop guard (every sentinel tick)
STOP_GUARD_ENABLED=1
# The weekly review may only tune params / file change requests once this many predictions are scored
MIN_SCORED_FOR_TUNING=30

# ─── Scheduling ──────────────────────────────────────────────────────────
SENTINEL_POLL_INTERVAL_SECONDS=60
SENTINEL_ESCALATION_COOLDOWN_MINUTES=30
INTRADAY_PULSE_INTERVAL_MINUTES=30

# ─── AI budget & timeouts ────────────────────────────────────────────────
# Budget-relevant tokens per day (input + output + cache writes + 10% of cache reads)
DAILY_AI_TOKEN_BUDGET=2000000
AI_TIMEOUT_MS=180000
ALPACA_API_TIMEOUT_MS=15000

# ─── P&L baseline ────────────────────────────────────────────────────────
# Optional. If unset, the first observed equity is captured once into bot_state.
STARTING_EQUITY=

# ─── Admin ───────────────────────────────────────────────────────────────
# Optional shared secret for POST /api/admin/jobs/:name from another machine
# (requests from the box itself are always allowed).
ADMIN_TOKEN=

# ─── Self-improvement pipeline (Pi only) ────────────────────────────────
# Path to a git checkout of this repo on the Pi. Blank disables the pipeline.
SELF_IMPROVE_REPO_DIR=
SELF_IMPROVE_BASE_BRANCH=main
# Per-change spend cap handed to `claude -p --max-budget-usd`
SELF_IMPROVE_MAX_BUDGET_USD=15
# 1 = build + activate a release on the Pi after an auto-merge; 0 = merge only
SELF_IMPROVE_AUTO_DEPLOY=1
# RELEASE marker of the live release (lets the bot confirm its own deploys)
RELEASE_FILE=
# Optional Discord webhook for approvals, deploys, and reflection headlines
DISCORD_WEBHOOK_URL=
